{
  "manifest_version": 3,
  "name": "Z.ai Auto Retry",
  "version": "1.2",
  "description": "Auto retry when 'peak hours' modal appears. Toggle ON/OFF by clicking the extension icon.",
  "permissions": ["storage"],
  "host_permissions": ["https://chat.z.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Z.ai Auto Retry"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.z.ai/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}